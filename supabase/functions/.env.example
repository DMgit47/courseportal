# ============================================================
# Edge Function secrets for wh-purchase-47 + push-lesson-event.
# Set with:  supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env and fill in real values — DO NOT commit it)
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Edge
# runtime — you do NOT set them here.
# ============================================================

# Shared secret GHL must send as header `x-webhook-secret` (MASTER §5). Invent a long random string.
WH_PURCHASE_47_SECRET=

# GoHighLevel API v2 (Private Integration Token) — never shipped to the browser.
GHL_PIT_TOKEN=
GHL_LOCATION_ID=4rsssMJDYkokbMDPoL16

# GHL custom-field id for `portal_setup_url` (see runbook for how to find it).
GHL_SETUP_URL_FIELD_ID=

# Public base URL of the portal (magic-link redirect target).
PORTAL_BASE_URL=http://localhost:3000

# GHL inbound webhook for per-lesson completion events (push-lesson-event, D3).
# GHL workflow: Inbound Webhook → Find Contact (by email) → Add Note.
GHL_LESSON_EVENT_WEBHOOK_URL=

# Target course + product matching (defaults shown; override if needed).
COURSE_47_SLUG=ecommerce-launch-blueprint
EXPECTED_47_PRODUCT_TITLE=$47 The E-commerce Launch Blueprint
